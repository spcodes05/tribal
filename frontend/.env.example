# Copy this file to .env and fill in your real keys.
# .env is gitignored and must NEVER be committed to GitHub.
#
# GOOGLE_MAPS_API_KEY is no longer used — the app now uses flutter_map with
# free OpenStreetMap tiles (no key, no billing) for the Explore map, the
# location picker, and the meeting-point preview on the activity detail
# screen. Place search/autocomplete already runs on free Nominatim
# (see lib/services/geocoding_service.dart). This line can be deleted.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
